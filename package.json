{
  "name": "watchface",
  "author": "MakeAwesomeHappen",
  "version": "1.0.0",
  "keywords": [
    "pebble-app"
  ],
  "private": true,
  "dependencies": {
    "@rebble/clay": "^1.0.10"
  },
  "pebble": {
    "displayName": "watchface",
    "uuid": "dcc44e7a-eb0d-49d1-883d-20b0f5338495",
    "sdkVersion": "3",
    "enableMultiJS": true,
    "targetPlatforms": [
      "aplite",
      "basalt",
      "chalk",
      "diorite",
      "emery",
      "flint",
      "gabbro"
    ],
    "watchapp": {
      "watchface": true
    },
    "capabilities": [
      "location",
      "configurable"
    ],
    "messageKeys": [
      "TEMPERATURE",
      "CONDITIONS",
      "REQUEST_WEATHER",
      "BackgroundColor",
      "TextColor",
      "TemperatureUnit",
      "ShowDate"
    ],
    "resources": {
      "media": [
        {
          "type": "font",
          "name": "FONT_PIXELIFY_SANS_MEDIUM_24",
          "file": "fonts/PixelifySans-Medium.ttf",
          "compatibility": "2.7"
        },
        {
          "type": "font",
          "name": "FONT_PIXELIFY_SANS_REGULAR_24",
          "file": "fonts/PixelifySans-Regular.ttf",
          "compatibility": "2.7"
        },
        {
          "type": "font",
          "name": "FONT_PIXELIFY_SANS_REGULAR_18",
          "file": "fonts/PixelifySans-Regular.ttf",
          "compatibility": "2.7"
        },
        {
          "type": "bitmap",
          "name": "IMAGE_BT_ICON",
          "file": "images/bt-icon.png"
        }
      ]
    }
  }
}
